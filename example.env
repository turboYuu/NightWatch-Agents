# 复制当前文件为 .env，再填入真实密钥（.env 已被 .gitignore 忽略）。
# 不要在本模板文件里保存真实凭据。

# E2B（建远端沙箱用；--dry-run 不需要）
E2B_API_KEY=********************************

# 模型：provider:model 格式
NW_MODEL_MAIN=deepseek:deepseek-v4-flash
NW_MODEL_FIX=deepseek:deepseek-v4-pro

# 对应 provider 的密钥，由 init_chat_model 自己读取
DEEPSEEK_API_KEY=********************************

# Langsmith 的配置信息
# 是否启用 Langsmith 监控功能
#LANGSMITH_TRACING=true
## Langsmith 监控 WebUI 地址
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
## 创建的 API_KEY
#LANGSMITH_API_KEY=********************************
## 自定义项目名称，可以在 Langsmith WebUI 监控页面根据名称查看对应的运行记录
#LANGSMITH_PROJECT="nightwatch-agents"
